{
  "name": "physio-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "models": "tsx scripts/build-open3d.ts",
    "models:bp3d": "node scripts/build-models.mjs",
    "models:report": "tsx scripts/muscle-fit-report.ts",
    "check": "node scripts/check-models.mjs",
    "check:rig": "tsx scripts/check-rig.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test": "npm run typecheck && npm run check && npm run check:rig && npm run test:unit"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^5.1.0"
  }
